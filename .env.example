# APTASK - Environment Variables
# Copy this file to .env.local and fill in your actual values

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Microsoft OAuth (Office 365)
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=common
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/auth/callback/azure-ad

# Anthropic AI (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# IMAP Configuration (for Gmail/Office 365 IMAP fallback)
IMAP_GMAIL_HOST=imap.gmail.com
IMAP_GMAIL_PORT=993
IMAP_OUTLOOK_HOST=outlook.office365.com
IMAP_OUTLOOK_PORT=993

# Database (for storing tokens and accounts)
# Optional - you can use localStorage for demo purposes
DATABASE_URL=postgresql://user:pass@localhost:5432/aptask
